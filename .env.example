# Gyde: environment template.
# Copy to `.env` (git-ignored) and adjust. NEVER put real secrets in this file.
# Every value below is a placeholder or a local-development default.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
WEB_PORT=3000
GATEWAY_PORT=4000
REGISTRY_PORT=4100
NORMALIZATION_PORT=4200
RETRIEVAL_PORT=4300
LLM_ANALYSIS_PORT=4400
REPORTS_PORT=4500

# ---------------------------------------------------------------------------
# Service discovery (Registry + Health Checker)
# ---------------------------------------------------------------------------
REGISTRY_URL=http://registry:4100
HEARTBEAT_INTERVAL_MS=5000
INSTANCE_TTL_MS=15000
HEALTH_CHECK_INTERVAL_MS=5000
HEALTH_CHECK_MAX_FAILURES=3

# Static service URLs: the fallback used when the registry cannot resolve a service.
# docker compose sets these to the container names automatically; these values are for running
# a service directly on your machine.
GATEWAY_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NORMALIZATION_URL=http://localhost:4200
RETRIEVAL_URL=http://localhost:4300
LLM_ANALYSIS_URL=http://localhost:4400
REPORTS_URL=http://localhost:4500

# ---------------------------------------------------------------------------
# Circuit breaker defaults (architecture doc: e.g. 5 failures or 50% in a window)
# ---------------------------------------------------------------------------
CB_FAILURE_THRESHOLD=5
CB_FAILURE_RATE=0.5
CB_WINDOW_MS=30000
CB_OPEN_TIMEOUT_MS=15000
CB_HALF_OPEN_MAX_CALLS=2
CB_CALL_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Database: one PostgreSQL, one schema + role per persisting service
# ---------------------------------------------------------------------------
POSTGRES_USER=gyde
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gyde
POSTGRES_PORT=5432
WEB_DATABASE_URL=postgres://web:change-me-web@postgres:5432/gyde
NORMALIZATION_DATABASE_URL=postgres://normalization:change-me-normalization@postgres:5432/gyde
REPORTS_DATABASE_URL=postgres://reports:change-me-reports@postgres:5432/gyde

# ---------------------------------------------------------------------------
# Internal service-to-service authentication (never exposed through the gateway)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=change-me-long-random-string

# ---------------------------------------------------------------------------
# Servicio Web: login (GitHub OAuth) and Stripe (TEST mode keys only)
# ---------------------------------------------------------------------------
AUTH_SECRET=change-me-long-random-string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_STUDIO=price_replace_me

# ---------------------------------------------------------------------------
# BYOK: keys that encrypt each studio's LLM API key at rest (AES-256-GCM).
# Format: kid:base64(32 bytes), comma separated. The active kid encrypts new keys;
# older kids stay available to decrypt (rotation).
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
LLM_KEY_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
LLM_KEY_ACTIVE_KID=k1

# ---------------------------------------------------------------------------
# Pipeline de Normalización: external knowledge sources
# ---------------------------------------------------------------------------
OSV_API_URL=https://api.osv.dev
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
GITHUB_TOKEN=
# Cadence per trust tier (high-trust sources refresh more often than community signals)
INGEST_HIGH_TRUST_CRON=0 * * * *
INGEST_COMMUNITY_CRON=0 3 * * *
# Read sources from /fixtures instead of the network (offline development and demos)
INGEST_USE_FIXTURES=true

# ---------------------------------------------------------------------------
# Servicio Análisis LLM
# ---------------------------------------------------------------------------
# Use the mock provider when a tenant has no LLM key (development only)
LLM_MOCK_ENABLED=true

# ---------------------------------------------------------------------------
# Client apps (CLI / GitHub Action / VS Code extension)
# ---------------------------------------------------------------------------
GYDE_API_URL=http://localhost:4000
GYDE_API_KEY=gyde_test_replace_me

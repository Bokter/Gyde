{
  "name": "@gyde/web",
  "version": "0.0.0",
  "private": true,
  "description": "Servicio Web: UI, Stripe subscriptions, API keys and tenant LLM keys (BYOK). Next.js app.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gyde/design-tokens build && pnpm migrate && next dev -p 3000",
    "migrate": "tsx src/infrastructure/db/migrate-cli.ts --skip-if-no-db",
    "seed:dev": "tsx src/modules/dev-seed/infrastructure/seed-dev-cli.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build:migrate": "tsup --config tsup.migrate.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@auth/drizzle-adapter": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gyde/contracts": "workspace:*",
    "@gyde/design-tokens": "workspace:*",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "next-auth": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
